---
import Layout from '../layouts/Layout.astro';
---

<Layout title="xiao-xiao-cai · 个人主页" description="xiao-xiao-cai 的个人展示空间，记录 AI 应用与智能体开发的探索。网站建设中。">
  <section class="hero" aria-labelledby="intro-title">
    <div>
      <p class="eyebrow">AI APPLICATIONS & AGENTS</p>
      <h1 id="intro-title">你好，<br />我是 <span>xiao-xiao-cai</span>。</h1>
      <p class="intro">这里将记录我在 AI 应用与智能体开发方向的探索，分享项目背后的思考、实现与成长。</p>
      <p class="status"><span aria-hidden="true"></span>网站建设中 · 内容陆续更新</p>
      <a class="button" href="https://github.com/xiao-xiao-cai">前往我的 GitHub <span aria-hidden="true">↗</span></a>
    </div>
    <figure>
      <img src="/images/site-preview.svg" width="480" height="400" alt="由三个相连节点组成的抽象网络插图，象征想法、实践与连接" />
      <figcaption>从一个想法，走向一次实践。</figcaption>
    </figure>
  </section>
</Layout>
