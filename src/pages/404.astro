---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面未找到 · xiao-xiao-cai" description="这个页面暂时无法找到，请返回个人主页继续浏览。">
  <section class="not-found" aria-labelledby="error-title">
    <p class="eyebrow">404 · PAGE NOT FOUND</p>
    <h1 id="error-title">这条路还没有抵达。</h1>
    <p class="intro">页面可能已移动，或链接地址有误。回到首页，继续了解我。</p>
    <a class="button" href="/">返回首页 <span aria-hidden="true">→</span></a>
  </section>
</Layout>
